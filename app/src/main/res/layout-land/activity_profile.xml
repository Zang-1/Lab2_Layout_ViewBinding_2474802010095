<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape profile: vertical Guideline at 35%.
     Left column: 1:1 avatar + name + role (packed vertical chain, centered).
     Right column: 4 label | value rows (Barrier) + chain of two buttons. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.35" />

        <!-- Left column -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgAvatar"
            android:layout_width="140dp"
            android:layout_height="0dp"
            android:background="?attr/colorSecondaryContainer"
            android:contentDescription="@string/avatar_desc"
            android:src="@drawable/ic_avatar"
            app:contentPadding="16dp"
            app:layout_constraintBottom_toTopOf="@id/tvFullName"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@id/guideProfile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Lab2.Circle" />

        <TextView
            android:id="@+id/tvFullName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/profile_name"
            android:textAlignment="center"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tvRole"
            app:layout_constraintEnd_toStartOf="@id/guideProfile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgAvatar" />

        <TextView
            android:id="@+id/tvRole"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/profile_role"
            android:textAlignment="center"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideProfile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFullName" />

        <!-- Right column -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="tvLabelEmail,tvLabelMssv,tvLabelClass,tvLabelPhone" />

        <TextView
            android:id="@+id/tvLabelEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:text="@string/label_email"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/guideProfile"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvValueEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textSize="16sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabelEmail"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/barrierLabel" />

        <TextView
            android:id="@+id/tvLabelMssv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_mssv"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvLabelEmail"
            app:layout_constraintTop_toBottomOf="@id/tvValueEmail" />

        <TextView
            android:id="@+id/tvValueMssv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/value_mssv"
            android:textSize="16sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabelMssv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/barrierLabel" />

        <TextView
            android:id="@+id/tvLabelClass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_class"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvLabelEmail"
            app:layout_constraintTop_toBottomOf="@id/tvValueMssv" />

        <TextView
            android:id="@+id/tvValueClass"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/value_class"
            android:textSize="16sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabelClass"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/barrierLabel" />

        <TextView
            android:id="@+id/tvLabelPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_phone"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvLabelEmail"
            app:layout_constraintTop_toBottomOf="@id/tvValueClass" />

        <TextView
            android:id="@+id/tvValuePhone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/value_phone"
            android:textSize="16sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabelPhone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/barrierLabel" />

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_edit"
            app:layout_constraintEnd_toStartOf="@id/btnLogout"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="@id/tvLabelEmail"
            app:layout_constraintTop_toBottomOf="@id/tvValuePhone" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_logout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/btnEdit"
            app:layout_constraintTop_toTopOf="@id/btnEdit" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
